# Copy to server/.env (this file is safe to commit, .env is not)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE_NAME
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# AI: choose ONE provider. Without any, the bot uses simple rules.
# 1) FREE: Google Gemini (key from aistudio.google.com, "Get API key")
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# AI_FALLBACK_MODEL=   (tried if the main model is overloaded)
# 2) FREE and offline: Ollama on your computer (see README)
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# 3) Paid: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# MAX_KB_CHARS=16000
# AI_THINKING_LEVEL=low   (Gemini 3 only, faster answers; remove if the API rejects it)
# KB_ALLOWED_HOSTS=picsartacademy.am,www.picsartacademy.am
# Later:
# NAVIGATOR_CRM_URL=
# NAVIGATOR_CRM_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
SEED_PASSWORD=replace-with-a-strong-unique-password
